{
  "name": "gitlab-version-tracker",
  "version": "1.0.0",
  "description": "Local web app to track default-branch versions across GitLab projects, including git-subtree base sync status.",
  "main": "server.js",
  "type": "commonjs",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server.js",
    "dev:client": "vite --host",
    "build": "vite build",
    "dev": "npm run build && npm start"
  },
  "dependencies": {
    "express": "^4.19.2",
    "react-router-dom": "^7.18.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "vite": "^5.4.0"
  }
}
